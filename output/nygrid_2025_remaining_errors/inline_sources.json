              {
                "label": "independent_pjm_partition_review.json"
              },
              {
                "label": "current_AC_vs_corrected_DC_same_hours.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Eastern import allocation sensitivity",
                "definition": "A bounded100publicMW transfer between external proxy buses130 and134 changes Total East and Central East while preserving regional generation totals."
              }
            ],
            "filters": [
              "15 calendar-selected hours",
              "30 qualified directional cases"
            ],
            "caveats": [
              "This is a local sensitivity, not observed historical dispatch or an annual improvement. Capacity-proportional alternatives were no-op controls."
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "Recorded checks",
                "detail": "Independent checks confirm finite unit bounds, regional total conservation, refreshed Q capabilities and score agreement within5.7e-14MW."
              }
            ]
          },
          "reportingPeriod": "2025 hourly model results; diagnosis completed October15,2026",
          "rows": [
