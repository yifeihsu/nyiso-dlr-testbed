    {
      "id": "western-pattern",
      "title": "Shared western residual",
      "queries": [
        {
          "id": "western-pattern-evidence",
          "source": {
            "label": "Shared western residual",
            "files": [
              {
                "label": "pairwise_residual_structure.csv"
              },
              {
                "label": "month_metrics.csv"
              },
              {
                "label": "local_hour_metrics.csv"
              },
              {
                "label": "niagara_monthly_prior_oracle_comparison.csv"
              },
              {
                "label": "niagara_saved_DC_counterfactuals_same8170_metrics.csv"
              },
              {
                "label": "accounting_identity_review.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Shared western residual",
                "definition": "Dysinger East and West Central share a variable residual; their complete model-cut identities isolate fixed zonal source inputs and small terminal corrections."
              }
            ],
            "filters": [
              "Identical8170-hour annual cohort"
            ],
            "caveats": [
              "The pattern does not identify Niagara as the sole historical cause. EIA full-calendar means and selected-hour model means have different populations. Saved counterfactuals are DC responses."
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "Recorded checks",
                "detail": "Exact cut-identity closure is below1.9e-10modelMW. Zero lag has the lowest MAE for all seven interfaces on7936 common qualified triplets."
              }
            ]
          },
          "reportingPeriod": "2025 hourly model results; diagnosis completed October15,2026",
          "rows": [
            {
              "correlation": 0.9982557071224564,
              "difference_mae_public_MW": 14.393481147407966,
              "common_variance_percent": 99.90846945934042
            }
          ],
          "columns": [
            {
              "field": "correlation",
              "label": "Residual correlation"
            },
            {
              "field": "difference_mae_public_MW",
              "label": "Residual difference MAE(MW)"
            },
            {
              "field": "common_variance_percent",
              "label": "Common variance(%)"
            }
          ]
        }
      ]
    },
    {
