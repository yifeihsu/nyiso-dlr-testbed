    {
      "id": "physical-limitations",
      "title": "Loss and voltage limitations",
      "queries": [
        {
          "id": "physical-limitations-evidence",
          "source": {
            "label": "Loss and voltage limitations",
            "files": [
              {
                "label": "physics_review.json"
              },
              {
                "label": "parent_loss_concentration.csv"
              },
              {
                "label": "voltage_bound_concentration.csv"
              },
              {
                "label": "paired_physical_responses.csv"
              },
              {
                "label": "independent_probe_review.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Loss and voltage limitations",
                "definition": "Annual losses are model-scale MW. Parent41 dominates zoneF assigned loss; all qualified annual hours exceed the voltage upper bound somewhere."
              }
            ],
            "filters": [
              "8170 annual qualified hours",
              "Parent41 sensitivity uses15 calendar-selected hours"
            ],
            "caveats": [
              "The parent41 admittance probe does not rebuild conductor or DLR metadata and was not promoted. Equation qualification does not establish operating feasibility."
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "Recorded checks",
                "detail": "The15 baseline cases reproduce all105 saved interface values exactly. Parent41 importedR/X reduces its sampled mean loss92.87\u21922.34modelMW with negligible interface response."
              }
            ]
          },
          "reportingPeriod": "2025 hourly model results; diagnosis completed October15,2026",
          "rows": [
            {
              "parent41_mean_loss_model_MW": 77.8967008507937,
              "F_loss_share_percent": 96.26810328606287,
              "overvoltage_hours": 8170,
              "maximum_voltage_pu": 1.1200050079088417
