{
  "schemaVersion": 1,
  "items": [
    {
      "id": "annual-errors",
      "title": "Remaining interface errors",
      "queries": [
        {
          "id": "annual-errors-evidence",
          "source": {
            "label": "Remaining interface errors",
            "files": [
              {
                "label": "comparison_arrays.npz"
              },
              {
                "label": "annual_metrics.csv"
              },
              {
                "label": "baseline_receipt.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "Remaining interface errors",
                "definition": "MAE and signed bias compare the frozen original-from-terminal model cuts with the corresponding observations, in public-scale MW. WAPE divides total absolute error by total absolute observed flow."
              }
            ],
            "filters": [
              "Current equation, loss and recovery qualified cohort:8170hours",
              "Failed solutions excluded"
            ],
            "caveats": [
              "Physical2025 P32 meter membership and the conditional numeric-as-MW source interpretation remain unverified."
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "Recorded checks",
                "detail": "All seven annual metrics reproduce the sealed current-model comparison exactly."
              }
            ]
          },
          "reportingPeriod": "2025 hourly model results; diagnosis completed October15,2026",
          "rows": [
            {
