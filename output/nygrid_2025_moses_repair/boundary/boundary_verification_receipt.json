      "limitation": "The schematic is not a bus-by-bus source/load census or operational switching history."
    },
    {
      "binding_id": "MMS_internal_scope",
      "status": "verified",
      "statement": "MS24 Table 3 identifies MMS1/MMS2 as Massena-Moses connections. Both stations are northern source ends in the 2025 D-to-E definition, making these links internal to the illustrated North NYCA pocket.",
      "source_ids": "MS24p10;2025seasonaldefinitionCSV",
      "limitation": "This inference uses documented endpoints and pocket topology. No model circuit identity or MMS flow is invented."
    },
    {
      "binding_id": "NX2020_distinct_boundary",
      "status": "verified",
      "statement": "The 2020 Northern Export definition adds MMS1, MMS2, L33P, L34P and PV20, and subtracts MSU1, relative to Moses South. It studies a distinct boundary with local North Country generation and zero external imports.",
      "source_ids": "NYISO_NX19_2020_indexed_table5A",
      "limitation": "Primary search-index text only; direct PDF retrieval encountered a JavaScript/robot challenge. The 2020 formula is not promoted to 2025 P32 weights or net Zone D accounting."
    },
    {
      "binding_id": "HQ_full_physical_aggregate",
      "status": "verified",
      "statement": "The HQ input is NYIS-HQT EIA930 net physical interchange counted once, import positive. The 2025 study identifies 7040 Chateauguay-Massena and Dennison/Cedars paths.",
      "source_ids": "EIA930;Summer25p19",
      "limitation": "The EIA aggregate does not separately measure Cedars and 7040. Merchant schedules must not be added again."
    },
    {
      "binding_id": "HQ_inside_northern_pocket",
      "status": "assumed",
      "statement": "Treat all 2025 NYIS-HQT physical interchange as entering the North NYCA pocket, consistent with the 2025 named links and MS24 Figure 2. Retain its net aggregate for pocket balance.",
      "source_ids": "MS24p12;Summer25p19",
      "limitation": "Collapse at bus 48 is an engineering representation. The bus-level split and meter-end losses remain unverified."
    },
    {
      "binding_id": "HQ_wheeling_no_subtraction",
      "status": "verified",
      "statement": "Summer25 distinguishes 7040 NYCA delivery of 1310 MW from 1800 MW total including wheeling. EIA records physical flow; wheeling must not be subtracted from HQT physical imports merely because its final destination is another BA.",
      "source_ids": "EIA930;Summer25p19",
      "limitation": "Limits provide context, not hourly telemetry or a numerical wheeling correction."
    },
    {
      "binding_id": "Ontario_PAR_current_inputs",
