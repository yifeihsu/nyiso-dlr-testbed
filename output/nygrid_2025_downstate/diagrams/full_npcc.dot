graph full_npcc {
	bgcolor=white dpi=115 fontcolor="#223246" fontname=Arial fontsize=22 label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="22">Full NPCC backbone with all 51 added buses</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15">51 added buses / 191 shown  |  all active AC branches, four DC equivalents and nine retired aggregate rows</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">Blue square boxes: ADDED buses; gray rounded boxes: ORIGINAL buses. Labels = name / model ID / nominal kV.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#226AA5">Blue lines: added historical source circuits</FONT>  |  <FONT POINT-SIZE="12" COLOR="#B87518">Gold dashed: added assumed connections</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12" COLOR="#C04754">Red dashed: replaced original branches (inactive)</FONT>  |  <FONT POINT-SIZE="12" COLOR="#73508E">Purple: unchanged DC equivalents</FONT>  |  <FONT POINT-SIZE="12" COLOR="#7E8791">Gray: retained; gray dotted: idle scaffold</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">xN = parallel branch count. Schematic, not geographic. Cross-voltage proxies are not certified physical transformers.</FONT></TD></TR></TABLE>> labeljust=l labelloc=t margin=0 outputorder=edgesfirst overlap=false pad=0.35 sep="+16" splines=true start=17
