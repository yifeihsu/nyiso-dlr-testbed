  "preambleText" : null,
  "preambleHtml" : "<script>\n    window.initDispatcherNotices = function() {\n        \n        var iframeUrl;\n        \n        if (window.Environment && window.CloudFrontBaseUrl && window.Environments) {\n            // If local environment, use QA environment URL\n            var env = window.Environment === window.Environments.LOCAL \n                ? window.Environments.QA \n                : null;\n            \n            var baseUrl = window.CloudFrontBaseUrl(env);\n            iframeUrl = baseUrl + '/OP_ANNOUNCEMENT/HTML/current.html';\n        } else {\n            // Fallback if globals are not available\n            console.warn('Environment globals not available, using fallback URL in QA for dispatcher notices iframe');\n            iframeUrl = 'https://oasis-postings.qa.nysdi.com/OP_ANNOUNCEMENT/HTML/current.html';\n        }\n        \n        var iframe = document.getElementById('dispatcher-notices-iframe');\n        \n        // Set the src if not already set\n        if (!iframe.src || iframe.src === window.location.href || iframe.src === '') {\n            iframe.src = iframeUrl;\n        }\n    };\n    \n    // Initialize after a short delay to ensure DOM is ready\n    setTimeout(function() {\n        if (typeof window.initDispatcherNotices === 'function') {\n            window.initDispatcherNotices();\n        }\n    }, 100);\n</script>\n<iframe id=\"dispatcher-notices-iframe\" src=\"\" width=\"100%\" height=\"2600px\" frameborder=\"0\" style=\"min-height: 600px;\"></iframe>",
